{
  "name": "Wi-Live",
  "short_name": "Wi-Live",
  "description": "Watch a computer's screen on your home network.",
  "start_url": "/",
  "scope": "/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
